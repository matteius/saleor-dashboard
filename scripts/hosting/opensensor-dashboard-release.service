[Unit]
Description=Build and deploy current main to the production Saleor dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash %h/.local/lib/opensensor-hosting/dashboard-release-launch.sh
TimeoutStartSec=38min
UMask=0077
Nice=5
